{
  "name": "promptfun",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "worker": "tsx server/worker.ts",
    "build": "vite build",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts src/lib/*.test.ts",
    "test:e2e": "playwright test",
    "local:up": "bun run scripts/local.ts",
    "local:env": "bun run scripts/local.ts --env-only",
    "db:migrate": "bun run scripts/migrate.ts",
    "backup": "bun run scripts/backup.ts backup",
    "backup:verify": "bun run scripts/backup.ts verify",
    "backup:restore": "bun run scripts/backup.ts restore",
    "cloud:verify": "bun run scripts/verify-cloud.ts",
    "cloud:configure": "bun run scripts/neon.ts",
    "solana:build": "bash scripts/solana-build-ci.sh",
    "solana:sync": "bun run scripts/solana-sync.ts"
  },
  "dependencies": {
    "@anchor-lang/core": "1.2.1",
    "@aws-sdk/client-s3": "3.980.0",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "^1.99.0",
    "@solflare-wallet/sdk": "1.4.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "cookie-parser": "1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "8.16.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "tweetnacl": "1.0.3",
    "vite": "^8.3.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.5",
    "@playwright/test": "1.61.1",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "supabase": "2.119.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.0.0",
    "bun": "1.4.2"
  },
  "packageManager": "bun@1.4.2"
}
