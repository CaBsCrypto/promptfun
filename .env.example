# Setup de desarrollo cloud. Copiar a .env (ignorado) si aún no existe.
# bun run local:env prepara claves persistentes sin requerir Docker.
BACKEND_PROVIDER=neon
NODE_ENV=development
PLATFORM_ORIGIN=http://localhost:3000
RUNTIME_ORIGIN=http://127.0.0.1:4000
# Acceso interno sin wallet/correo; sólo loopback y desarrollo. Desactivado por defecto.
LOCAL_DEMO_ENABLED=false

# Dos proyectos Neon dedicados: promptfun-control / promptfun-apps, AWS us-east-1.
# IDs de proyectos existentes para bun run cloud:configure; nunca reutilizar otros.
NEON_CONTROL_PROJECT_ID=
NEON_APPS_PROJECT_ID=
# Opcionales: deben coincidir con la branch donde Managed Auth está habilitado.
NEON_CONTROL_BRANCH_ID=
NEON_APPS_BRANCH_ID=

# Conexiones Postgres emitidas por Neon; nunca claves en variables VITE_*.
CONTROL_DATABASE_URL=
APPS_DATABASE_URL=

# Endpoints de Managed Neon Auth de cada plano (no hostname Postgres).
# Email/contraseña requiere confirmar correo. Google no está configurado en Neon.
CONTROL_AUTH_URL=
APPS_AUTH_URL=

# Neon Storage: credenciales del bucket privado en el proyecto apps.
NEON_STORAGE_ENDPOINT=
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=
NEON_STORAGE_BUCKET=app-files
NEON_STORAGE_REGION=us-east-1

# 32 bytes aleatorios en base64. Los genera local:env; conservar entre reinicios.
# Guardar únicamente en .env ignorado o gestor de secretos del servidor.
ENCRYPTION_KEY=
RUNTIME_SIGNING_KEY=

# OAuth OpenRouter propio desde UI; la clave se cifra en el servidor.
# No colocar una API key aquí ni en almacenamiento del navegador.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Sólo Devnet. ID del programa tras comprobar artefacto y despliegue.
SOLANA_RPC_URL=https://api.devnet.solana.com
MARKET_PROGRAM_ID=
# Ruta absoluta a keypair técnico externo al repositorio, no contenido de clave.
MARKET_REGISTRAR_KEY_PATH=

# Compatibilidad Supabase opcional; no requerida en el flujo Neon actual.
# CONTROL_SUPABASE_URL=
# CONTROL_PUBLISHABLE_KEY=
# APPS_SUPABASE_URL=
# APPS_PUBLISHABLE_KEY=
# APPS_SECRET_KEY=

# Google opcional futuro: configurar en proveedor + BFF revisado.
# Este adapter Neon no usa GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET actualmente.
# No agregar credenciales Google hasta implementar y verificar ese flujo.
